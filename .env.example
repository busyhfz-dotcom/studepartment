# PostgreSQL / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Better Auth
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ORCID OAuth
# Keep sandbox for local/staging. Production redirect URIs must be registered exactly and use HTTPS.
ORCID_ENVIRONMENT="sandbox"
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
ORCID_REDIRECT_URI="http://localhost:3000/api/integrations/orcid/callback"

# Semantic retrieval
# Optional. Discovery remains structured-lexical when this is not configured.
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
