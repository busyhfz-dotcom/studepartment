# Local PostgreSQL. `docker compose up -d` starts a compatible instance.
DATABASE_URL="postgresql://studepartment:studepartment@localhost:5432/studepartment?schema=public"

# AI is intentionally provider-agnostic. The demo provider requires no key.
AI_PROVIDER="demo"

# Public app origin used by future auth/email integrations.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
