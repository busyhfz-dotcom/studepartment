# Runtime
# development | test | ci | staging | production
DEPLOYMENT_ENV="development"
# Optional release identifier surfaced by health endpoints.
RELEASE_SHA=""
NEXT_TELEMETRY_DISABLED="1"

# PostgreSQL / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Better Auth
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Use only a header that your trusted reverse proxy overwrites.
AUTH_IP_HEADER="x-forwarded-for"
# Optional comma-separated proxy IPs/CIDRs. Keep empty unless you know the proxy chain.
AUTH_TRUSTED_PROXIES=""

# ORCID OAuth
# Keep sandbox for local/staging. Production redirect URIs must be registered exactly and use HTTPS.
ORCID_ENVIRONMENT="sandbox"
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
ORCID_REDIRECT_URI="http://localhost:3000/api/integrations/orcid/callback"

# PubMed / NCBI E-utilities
# NCBI asks API clients to include a contact email. API key is optional and increases the documented request ceiling.
NCBI_EUTILS_EMAIL=""
NCBI_API_KEY=""

# Semantic retrieval
# Optional. Discovery remains structured-lexical when this is not configured.
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Cost-sensitive default for grounded Research Assistant synthesis. Override per deployment if needed.
OPENAI_ASSISTANT_MODEL="gpt-5.6-luna"

# Opportunity Intelligence ingestion
# Generate a long random token. Values shorter than 32 characters are rejected by env validation.
OPPORTUNITY_INGEST_TOKEN=""
